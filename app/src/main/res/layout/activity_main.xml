<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.main.MainActivity"
    android:fitsSystemWindows="true"
    android:background="@drawable/browser_surface"
    tools:deviceIds="tv"
    android:clipChildren="false">

    <com.phlox.tvwebbrowser.widgets.cursor.CursorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/flWebViewContainer" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:id="@+id/progressBar"
        android:progressTint="@color/progressbar_tint"
        android:visibility="visible" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rlActionBar"
        android:background="@drawable/browser_surface"
        android:elevation="5dp"
        android:clipChildren="false"
        android:clipToPadding="false">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llNavigationPanel"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:clipChildren="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibHome"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_home"
                android:src="@drawable/ic_home_grey_900_24dp"
                app:cardLabel="@string/menu_home"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ibBack"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibBack"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_back"
                android:src="@drawable/back_icon_selector"
                app:cardLabel="@string/menu_back"
                app:layout_constraintStart_toEndOf="@id/ibHome"
                app:layout_constraintEnd_toStartOf="@id/ibForward"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibForward"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_forward"
                android:src="@drawable/forward_icon_selector"
                app:cardLabel="@string/menu_forward"
                app:layout_constraintStart_toEndOf="@id/ibBack"
                app:layout_constraintEnd_toStartOf="@id/ibRefresh"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibRefresh"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/refresh_page"
                android:src="@drawable/ic_refresh_grey_900_24dp"
                app:cardLabel="@string/menu_refresh"
                app:layout_constraintStart_toEndOf="@id/ibForward"
                app:layout_constraintEnd_toStartOf="@id/ibAdBlock"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibAdBlock"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/toggle_ads_blocking"
                android:src="@drawable/ic_adblock_on"
                app:cardLabel="@string/menu_ads"
                app:layout_constraintStart_toEndOf="@id/ibRefresh"
                app:layout_constraintEnd_toStartOf="@id/ibPopupBlock"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibPopupBlock"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/block_popups"
                android:src="@drawable/ic_block_popups"
                app:cardLabel="@string/menu_popups"
                app:layout_constraintStart_toEndOf="@id/ibAdBlock"
                app:layout_constraintEnd_toStartOf="@id/ibCloseTab"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibCloseTab"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/close_tab"
                android:src="@drawable/ic_close_grey_900_24dp"
                app:cardLabel="@string/menu_close"
                app:layout_constraintStart_toEndOf="@id/ibPopupBlock"
                app:layout_constraintEnd_toStartOf="@id/ibAddTab"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.phlox.tvwebbrowser.activity.main.view.MenuCardButton
                android:id="@+id/ibAddTab"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_menu_row_height"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/open_new_tab"
                android:src="@drawable/ic_add_tab"
                app:cardLabel="@string/menu_new_tab"
                app:layout_constraintStart_toEndOf="@id/ibCloseTab"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvBlockedAdCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@+id/ibAdBlock"
                app:layout_constraintBottom_toTopOf="@+id/ibAdBlock"
                app:layout_constraintStart_toEndOf="@+id/ibAdBlock"
                app:layout_constraintEnd_toEndOf="@+id/ibAdBlock"
                android:background="@drawable/gray_badge_bg"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="1" />

            <TextView
                android:id="@+id/tvBlockedPopupCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@+id/ibPopupBlock"
                app:layout_constraintBottom_toTopOf="@+id/ibPopupBlock"
                app:layout_constraintStart_toEndOf="@+id/ibPopupBlock"
                app:layout_constraintEnd_toEndOf="@+id/ibPopupBlock"
                android:background="@drawable/gray_badge_bg"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.phlox.tvwebbrowser.activity.main.view.tabs.TabsView
            android:id="@+id/vTabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/browser_menu_row_height"
            android:layout_below="@id/llNavigationPanel"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:focusable="true"
            android:nextFocusUp="@+id/ibHome"
            />
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivMiniatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llMiniaturePlaceholder"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignWithParentIfMissing="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_add_box_24"
            android:layout_marginEnd="20dp"
            tools:ignore="ContentDescription" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:text="@string/open_a_new_tab_here" />
    </LinearLayout>



    <com.phlox.tvwebbrowser.activity.main.view.CursorMenuView
        android:id="@+id/vCursorMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        />

    <ProgressBar
        android:id="@+id/progressBarGeneric"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />

</RelativeLayout>
