<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:padding="14dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="6dp"
        android:background="@drawable/bookmark_icon_background"
        android:clipToOutline="true"
        android:scaleType="fitCenter"
        android:id="@+id/ivIcon"
        android:src="@drawable/ic_not_available" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:layout_weight="1"
        android:id="@+id/llContent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvTitle"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/day_night_text_color_contrast"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvUrl"
            android:textSize="14sp"
            android:textColor="#B5BED5"
            android:layout_marginTop="5dp"
            android:lines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/ibDelete"
        android:background="@drawable/button_bg_selector"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_delete_grey_400_24dp"
        android:minHeight="50dp"
        android:minWidth="50dp" />
</LinearLayout>
