<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="5dp"
    android:paddingRight="22dp"
    >

    <LinearLayout
        android:id="@+id/llWebEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/web_browser_engine_temporary_setting"
            android:textSize="16sp"
            />

        <com.phlox.tvwebbrowser.activity.main.dialogs.settings.RemoteOptionPicker
            android:id="@+id/spWebEngine"
        android:nextFocusUp="@id/btnMainTab"
        android:prompt="@string/web_browser_engine_temporary_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_default_search_engine"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />

    <com.phlox.tvwebbrowser.activity.main.dialogs.settings.RemoteOptionPicker
        android:id="@+id/spEngine"
        android:nextFocusUp="@id/btnMainTab"
        android:prompt="@string/choose_default_search_engine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <LinearLayout
        android:id="@+id/llURL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        >

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:text="@string/url"
          android:textSize="16sp"
          />

      <EditText
          android:id="@+id/etUrl"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ems="10"
          android:hint="@string/search_engine_url_with_query_placeholder_query"
          android:importantForAutofill="no"
          android:inputType="textUri"
          />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_page"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        />

    <com.phlox.tvwebbrowser.activity.main.dialogs.settings.RemoteOptionPicker
        android:id="@+id/spHomePage"
        android:prompt="@string/home_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <LinearLayout
        android:id="@+id/llCustomHomePage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/custom_home_page_url"
            android:textSize="16sp"
            />

        <EditText
            android:id="@+id/etCustomHomePageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            />
    </LinearLayout>



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_user_agent_string"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />

    <com.phlox.tvwebbrowser.activity.main.dialogs.settings.RemoteOptionPicker
        android:id="@+id/spTitles"
        android:prompt="@string/choose_user_agent_string"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <LinearLayout
        android:id="@+id/llUAString"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        >

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:text="@string/user_agent_string"
          android:textSize="16sp"
          />

      <EditText
          android:id="@+id/etUAString"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ems="10"
          android:hint="@string/edit_user_agent_string"
          android:importantForAutofill="no"
          android:inputType="textUri"
          />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llAdblock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lines="1"
            android:text="@string/toggle_ads_blocking"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/scAdblock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:duplicateParentState="true" />
    </LinearLayout>

  <LinearLayout
      android:id="@+id/llAdBlockerDetails"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="20dp"
      android:orientation="vertical"
      >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/settings_subscription_background"
        android:orientation="vertical"
        android:padding="12dp">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/easylist_subscription_title"
          android:textColor="@color/day_night_text_color_contrast"
          android:textSize="16sp"
          android:textStyle="bold" />
      <EditText
          android:id="@+id/etAdBlockerListUrl"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:background="@drawable/settings_subscription_input_background"
          android:hint="@string/url"
          android:importantForAutofill="no"
          android:inputType="textUri|textMultiLine"
          android:maxLines="2"
          android:scrollHorizontally="false"
          android:minHeight="48dp"
          android:padding="12dp"
          android:textColor="@color/day_night_text_color_contrast"
          android:textSize="16sp"
          android:nextFocusUp="@id/llAdblock"
          android:nextFocusDown="@id/etChinaAdBlockerListUrl" />
      <TextView
          android:id="@+id/tvAdBlockerListInfo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/day_night_text_color"
          android:textSize="13sp"
          tools:text="最后更新：2026-10-09 14:40" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/settings_subscription_background"
        android:orientation="vertical"
        android:padding="12dp">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/easylist_china_subscription_title"
          android:textColor="@color/day_night_text_color_contrast"
          android:textSize="16sp"
          android:textStyle="bold" />
      <EditText
          android:id="@+id/etChinaAdBlockerListUrl"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:background="@drawable/settings_subscription_input_background"
          android:importantForAutofill="no"
          android:inputType="textUri|textMultiLine"
          android:maxLines="2"
          android:scrollHorizontally="false"
          android:minHeight="48dp"
          android:padding="12dp"
          android:textColor="@color/day_night_text_color_contrast"
          android:textSize="16sp"
          android:nextFocusUp="@id/etAdBlockerListUrl"
          android:nextFocusDown="@id/btnAdBlockerUpdate"
          android:hint="@string/url" />
      <TextView
          android:id="@+id/tvChinaAdBlockerListInfo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/day_night_text_color"
          android:textSize="13sp"
          tools:text="最后更新：2026-10-09 14:40" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btnAdBlockerUpdate"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:minHeight="48dp"
          android:background="@drawable/settings_action_background"
          android:backgroundTint="@null"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:paddingTop="8dp"
          android:paddingBottom="8dp"
          android:drawableStart="@drawable/ic_rules_refresh"
          android:drawablePadding="8dp"
          android:text="@string/adblock_update_subscriptions"
          android:textAllCaps="false"
          android:textColor="@color/day_night_text_color_contrast"
          android:textSize="15sp"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:nextFocusUp="@id/etChinaAdBlockerListUrl"
          android:nextFocusDown="@+id/spTheme"
          />
      <ProgressBar
          android:id="@+id/pbAdBlockerListLoading"
          style="?android:attr/progressBarStyle"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_marginStart="12dp"
          android:layout_weight="0"
          android:visibility="gone"
          />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:id="@+id/llThemeSettings"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingTop="5dp"
      >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme"
        android:textSize="16sp"
        />

    <com.phlox.tvwebbrowser.activity.main.dialogs.settings.RemoteOptionPicker
        android:id="@+id/spTheme"
        android:prompt="@string/theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scWebViewAlgorithmicDarkeningWithDarkUiMode"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/webview_use_algorithmic_darkening_with_dark_ui_mode"
        android:textSize="16sp"
        />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scWebViewAlgorithmicDarkeningWithDarkUiMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scAllowAutoplayMedia"
        android:nextFocusUp="@+id/spTheme"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/allow_autoplay_media"
        android:textSize="16sp"
        />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scAllowAutoplayMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scWebEngineDebug"
        android:nextFocusUp="@+id/scWebViewAlgorithmicDarkeningWithDarkUiMode"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/web_engine_debug"
        android:textSize="16sp"
        />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scWebEngineDebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scKeepScreenOn"
        android:nextFocusUp="@+id/scAllowAutoplayMedia"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/toggle_keep_screen_on"
        android:textSize="16sp"
        />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scKeepScreenOn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scNavigateWithJoystickAxes"
        android:nextFocusUp="@+id/scWebEngineDebug"
        android:layout_weight="0"
        />
  </LinearLayout>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/navigate_with_joystick_axes"
        android:textSize="16sp"
        />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scNavigateWithJoystickAxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/sbCursorMaxSpeed"
        android:nextFocusUp="@+id/scKeepScreenOn"
        android:layout_weight="0"
        />
  </LinearLayout>
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:text="@string/cursor_max_speed"
      android:textSize="16sp"
      />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      >
    <SeekBar
        android:id="@+id/sbCursorMaxSpeed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:max="175"
        android:nextFocusDown="@+id/sbCursorAcceleration"
        android:nextFocusUp="@+id/scNavigateWithJoystickAxes"
        />
    <TextView
        android:id="@+id/tvCursorMaxSpeedValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="72dp"
        android:gravity="end"
        android:textSize="14sp"
        tools:text="100%"
        />
  </LinearLayout>
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/cursor_acceleration"
      android:textSize="16sp"
      />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      >
    <SeekBar
        android:id="@+id/sbCursorAcceleration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:max="175"
        android:nextFocusDown="@+id/btnClearWebCache"
        android:nextFocusUp="@+id/sbCursorMaxSpeed"
        />
    <TextView
        android:id="@+id/tvCursorAccelerationValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="72dp"
        android:gravity="end"
        android:textSize="14sp"
        tools:text="100%"
        />
  </LinearLayout>
  <androidx.appcompat.widget.AppCompatButton
      android:id="@+id/btnClearWebCache"
      android:layout_width="wrap_content"
      android:layout_height="52dp"
      android:layout_marginTop="20dp"
      android:background="@drawable/settings_action_background"
      android:backgroundTint="@null"
      android:minWidth="168dp"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:gravity="center"
      android:textColor="@color/day_night_text_color_contrast"
      android:textSize="18sp"
      android:textAllCaps="false"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:nextFocusUp="@+id/sbCursorAcceleration"
      android:text="@string/clear_web_cache" />
  <View
      android:layout_width="match_parent"
      android:layout_height="50dp"
      />
</LinearLayout>
