<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/button_background_pressed" />
            <stroke android:width="2dp" android:color="@color/focus_outline" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/button_background_focused" />
            <stroke android:width="2dp" android:color="@color/focus_outline" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/button_background" />
            <stroke android:width="1dp" android:color="@color/button_corner" />
        </shape>
    </item>
</selector>
