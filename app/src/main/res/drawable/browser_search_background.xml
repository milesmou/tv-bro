        <shape><corners android:radius="12dp" /><solid android:color="#35405C" />
            <stroke android:width="1dp" android:color="@color/focus_outline" />
            <padding android:left="16dp" android:right="16dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape><corners android:radius="12dp" /><solid android:color="#25304A" />
            <padding android:left="16dp" android:right="16dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
